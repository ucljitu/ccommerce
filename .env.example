# Public business contact details. Leave unverified values empty to hide them.
NEXT_PUBLIC_SUPPORT_EMAIL=support@ccommerce.com.bd
NEXT_PUBLIC_WHATSAPP_NUMBER=8801833876434
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_OFFICE_ADDRESS=
NEXT_PUBLIC_SUPPORT_HOURS=
NEXT_PUBLIC_SUPPORT_AVAILABILITY=Response times may vary depending on the inquiry.

# cPanel: set this to a writable path outside public_html when possible.
CONTACT_STORAGE_PATH=

# Optional server-side notification receiver. The inquiry is still stored if this fails.
CONTACT_NOTIFICATION_WEBHOOK_URL=

# Set a long random value in production.
CONTACT_RATE_LIMIT_SALT=

# MySQL
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=false

# Bd Payment uses the same base host; the saved merchant key and mode identify
# whether a transaction is Sandbox or Production.
BDPAY_BASE_URL=https://payment.bdpayment.online
APP_URL=https://yourdomain.com

# 32 random bytes encoded as base64. Never expose this to the browser.
PAYMENT_CREDENTIAL_ENCRYPTION_KEY=

# Session security
MERCHANT_SESSION_SECRET=
